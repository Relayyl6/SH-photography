rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is authenticated owner (custom claim or verified admin email)
    function isOwner() {
      return request.auth != null && (
        (request.auth.token.role == 'owner' && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        request.auth.token.email in ['shfotography1@gmail.com', 'oseghaleleonard39@gmail.com']
      );
    }

    // Helper: is customer owner of doc
    function isCustomerOwner(customerUid) {
      return request.auth != null && request.auth.uid == customerUid;
    }

    // Settings (Site, Contact, Social, Booking)
    match /settings/{docId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    // Pages (Home, About, SiteText)
    match /pages/{pageId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    // Bento (Home)
    match /bento/{docId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    // Portfolio
    match /portfolio/{imageId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    // Sessions & Packages
    match /sessions/{sessionId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    match /packages/{packageId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    // Booking Fields
    match /bookingFields/{fieldId} {
      allow read: if resource.data.published == true || isOwner();
      allow write: if isOwner();
    }

    // Availability
    match /availability/{dateISO} {
      allow read: if resource.data.isOpen == true || isOwner();
      allow write: if isOwner();
    }

    match /blockedPeriods/{periodId} {
      allow read, write: if isOwner();
    }

    // Bookings (Private: only customer or owner)
    match /bookings/{bookingId} {
      allow read: if isOwner() || (resource != null && isCustomerOwner(resource.data.customerUid));
      allow write: if isOwner();
      // Creation allowed from client only if user is logged in and customerUid matches, or via Functions
      allow create: if request.auth != null && request.resource.data.customerUid == request.auth.uid;
    }

    // Customers
    match /customers/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isOwner());
    }

    // Admins list
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // only via Admin SDK / bootstrap
    }

    // Audit Log & Mail queue
    match /auditLog/{logId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    match /mail/{mailId} {
      allow read, write: if isOwner();
    }
  }
}
