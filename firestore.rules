rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is authenticated owner (custom claim or verified admin email)
    function isOwner() {
      return request.auth != null && (
        (request.auth.token.role == 'owner' && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        request.auth.token.email in ['shfotography1@gmail.com', 'oseghaleleonard39@gmail.com']
      );
    }

    // Helper: is customer owner of doc
    function isCustomerOwner(customerUid) {
      return request.auth != null && request.auth.uid == customerUid;
    }

    // Settings (Site, Contact, Social, Booking, Availability)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Pages (Home, About, SiteText)
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Bento (Home)
    match /bento/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Portfolio
    match /portfolio/{imageId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Sessions & Packages
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Booking Fields
    match /bookingFields/{fieldId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Availability (must be readable by public visitors so date picker knows blocked dates)
    match /availability/{dateISO} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /blockedPeriods/{periodId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Bookings (Quote Requests)
    // Public visitors can create a new quote request/booking.
    // Reading allowed so findSlotConflict can query active slots to avoid double-bookings.
    // Update allowed for owner, or customer claiming unassigned booking / booking matching their email.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if true;
      allow update: if isOwner() || (
        request.auth != null && (
          (resource != null && isCustomerOwner(resource.data.customerUid)) ||
          (resource != null && resource.data.customerUid == null) ||
          (resource != null && request.auth.token.email != null && resource.data.customer != null && request.auth.token.email == resource.data.customer.email)
        )
      );
      allow delete: if isOwner() || (resource != null && isCustomerOwner(resource.data.customerUid));
    }

    // Inquiries (Contact page messages)
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isOwner();
    }

    // Customers
    match /customers/{uid} {
      allow create: if true;
      allow read, update, delete: if isOwner() || (request.auth != null && request.auth.uid == uid);
    }

    // Admins list
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // Audit Log & Mail queue
    match /auditLog/{logId} {
      allow read, write: if isOwner();
    }

    match /mail/{mailId} {
      allow read, write: if isOwner();
    }
  }
}
