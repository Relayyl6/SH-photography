rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isOwner() {
      return request.auth != null && (
        request.auth.token.role == 'owner' ||
        request.auth.token.email in ['shfotography1@gmail.com', 'oseghaleleonard39@gmail.com']
      );
    }

    function isValidImage() {
      return request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*'));
    }

    // Public readable images
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isValidImage();
    }

    match /about/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isValidImage();
    }

    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isValidImage();
    }

    match /sessions/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isValidImage();
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isValidImage();
    }
  }
}
